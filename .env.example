APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/crossval_orders?replicaSet=rs0&directConnection=true
# Integration tests use this dedicated URI and a unique per-run database.
MONGODB_TEST_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
# Optional safe prefix; the value must end in _test or _integration.
MONGODB_TEST_DATABASE=crossval_orders_test
# Set only for an intentional remote integration-test run.
# ALLOW_REMOTE_MONGODB_TEST=true
# Use a separate schema-admin credential in deployment; local development may reuse the runtime URI.
MONGODB_MIGRATION_URI=mongodb://localhost:27017/crossval_orders?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=crossval_orders
SESSION_TTL_SECONDS=604800
