{
  "name": "crossval-orders-and-settlements",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "npm@11.11.0",
  "allowScripts": {
    "argon2": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:init": "tsx --env-file-if-exists=.env.local scripts/db-init.ts",
    "db:up": "docker compose up -d --wait mongodb && docker compose run --rm mongo-init",
    "db:down": "docker compose down",
    "docker:build": "docker build --platform linux/arm64 --tag crossval-orders:local .",
    "deploy:smoke": "sh scripts/deploy-smoke.sh"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "mongodb": "7.5.0",
    "next": "16.3.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
